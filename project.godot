; Isolith — project settings.
;
; Input bindings are deliberately NOT stored here. They are declared in
; src/Core/GameInput.cs, which keeps them readable in a diff and identical
; across Godot versions. Any [input] section added below would take precedence
; over those code defaults.

config_version=5

[application]

config/name="Isolith"
config/description="An isometric 3D platformer with optional AT Protocol stat sync."
run/main_scene="res://scenes/Menu.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="Isolith"

[layer_names]

3d_physics/layer_1="World"
3d_physics/layer_2="Player"
3d_physics/layer_3="Trigger"

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
environment/defaults/default_clear_color=Color(0.105882, 0.125490, 0.200000, 1)
